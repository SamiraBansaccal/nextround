# NextRound: every environment variable, WITHOUT any value.
# This file is committed: never write a real key in it. Your real values go in `.env`, which git ignores.
#
# Copy this file to `.env` and fill each value from the provider's website (README, option B).
# A line left empty ("NAME=") counts as not set.

# ---------- Needed to run the app ----------

# Neon, the Postgres database. Installed from the Vercel Marketplace, it sets DATABASE_URL (pooled, used by the
# app) and DATABASE_URL_UNPOOLED (direct, used by the migrations). By hand: your database's connection string
# ("postgresql://…") in DATABASE_URL. DB_CONNECTION_STRING is the older name, read when DATABASE_URL is empty.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DB_CONNECTION_STRING=
# Neon Auth, the sign-in (ADR 0028): the auth service of your Neon branch. Installed from the Vercel Marketplace
# with its "Auth" option, Neon sets it; by hand: `npx neon neon-auth status` prints it ("Base URL").
NEON_AUTH_BASE_URL=
# 32 random characters or more (`openssl rand -base64 32`), to sign the session cookies. One per deployment.
NEON_AUTH_COOKIE_SECRET=
# 32 random bytes in base64 (`openssl rand -base64 32`), to encrypt the API keys your users save.
# Never change it once users have saved keys: they could no longer be decrypted.
APP_ENCRYPTION_KEY=
# The instance owner's NUMERIC GitHub id: the "id" of https://api.github.com/users/<github-login>.
# Only that account may use the instance keys below. Empty = nobody is the owner.
OWNER_GITHUB_ID=

# ---------- Instance keys: for the OWNER's account only (every other account brings its own) ----------

# OpenRouter: the AI of the owner's account (free models). Empty = the owner adds a key in Settings too.
OPENROUTER_API_API_KEY=
# Firecrawl: reads offer pages that block a simple fetch. Optional.
FIRECRAWL_API_API_KEY=
# ElevenLabs: voices. It spends paid credits, so it is only used when INSTANCE_VOICE_ENABLED=true.
ELEVENLABS_API_KEY=
INSTANCE_VOICE_ENABLED=false
# Anthropic (Claude, paid per call): preferred over OpenRouter for the owner when set. Optional.
ANTHROPIC_API_KEY=
# Where people without an invitation may write to ask for one, shown on the home page. Empty = no address shown.
ACCESS_CONTACT_EMAIL=
# Resend: emails the owner (free plan). Kept ready for the invitations, which come back later (ADR 0028).
RESEND_API_KEY=
# The sender of that email. Empty = Resend's test sender, which only delivers to the Resend account's own address.
ACCESS_MAIL_FROM=
# The site's public address, for links in that email ("https://…"). Empty on Vercel = its production domain.
APP_URL=

# ---------- Optional tuning ----------

# Models used with the instance key (defaults in lib/ai/providers.ts); fallbacks are comma-separated.
INSTANCE_LLM_MODEL=
INSTANCE_LLM_FALLBACK_MODELS=
INSTANCE_ANTHROPIC_MODEL=
# Self-hosting only: let users point the AI at any OpenAI-compatible URL, such as a local Ollama.
# Keep it false on a site other people use: the server would call any address they type.
ALLOW_CUSTOM_LLM_BASE_URL=false

# ---------- Scripts that deploy from your computer (scripts/infra/) ----------

# Vercel, the hosting: written by Stripe Projects. The token expires; scripts/infra/deploy.mjs renews it.
# By hand: a token from https://vercel.com/account/tokens, and the two ids written by `npx vercel link`.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# The owner's user id (Neon Auth), to skip looking it up in the owner scripts (`npm run owner:whoami`). Optional.
OWNER_USER_ID=
