
# Stripe Projects: machine-specific state (Stripe account id, project id, provider links).
# Not a credential, but personal identifiers — kept out of this PUBLIC repo.
.projects/state.local.json
# Upstream state set aside by scripts/bootstrap.mjs in a fresh clone: local only.
.projects/state.upstream.json

# OS
.DS_Store


# Next.js
/node_modules
/.next/
/out/
/build
/coverage
*.pem
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
.vercel


# Visual checks (Playwright)
/e2e-screens/
/test-results/
/playwright-report/

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example

# Personal, machine-only files (your own CVs, offers, import scripts): never committed
/.local/

# Avatar reference candidates (large, re-downloadable with scripts/avatars/collect-references.py)
/assets/characters/*/candidates/*.png

# UI preview (scripts in .preview/): generated files
/.preview/*.png
/.preview/app.js
/.preview/out.css

# Python bytecode
__pycache__/
