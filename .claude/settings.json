{
  "permissions": {
    "allow": [
      "Bash(stripe projects status:*)",
      "Bash(stripe projects catalog:*)",
      "Bash(stripe projects search:*)",
      "Bash(stripe projects llm-context:*)",
      "Bash(stripe projects spend:*)",
      "Bash(stripe projects env list:*)",
      "Bash(stripe projects env show:*)",
      "Bash(stripe docs:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
